---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';

const camp = (await getEntry('camp', 'camp'))!.data;
const settings = (await getEntry('settings', 'settings'))!.data;
const { header, rituals_eyebrow, rituals, day } = camp;

// "9:00 AM" → ["9:00", "AM"], so AM/PM can sit smaller beside the big numbers.
const splitTime = (t: string) => t.match(/^(.*?)\s*([AP]M)?$/i)!.slice(1);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const arrow = (points: string) =>
	`<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="${points}"></polyline></svg>`;
---

<Base title="Our Camp" description={header.intro}>
	<PageHeader eyebrow={header.eyebrow} title={header.title}>
		<p class="lede">{header.intro}</p>
	</PageHeader>

	<section class="slider" data-slider data-seconds={settings.slide_seconds} aria-roledescription="carousel" aria-label="Our rituals">
		<div class="eyebrow">{rituals_eyebrow}</div>
		<div class="slider-nav">
			<div class="slide-tabs" style={`--count: ${rituals.length}`}>
				{
					rituals.map((r, i) => (
						<button class="slide-tab" data-go={i} aria-selected={i === 0 ? 'true' : 'false'}>
							<span class="bar"><span class="fill" /></span>
							<span class="tab-label">
								<span class="mono-label">{roman[i] ?? i + 1}</span>
								<span class="tab-name">{r.name}</span>
							</span>
						</button>
					))
				}
			</div>
		</div>
		<div class="stage">
			<button class="icon-btn arrow" data-prev aria-label="Previous ritual" set:html={arrow('10,3 5,8 10,13')} />
			<div class="slides">
				{
					rituals.map((r, i) => (
						<article class="slide" data-state={i === 0 ? 'current' : 'after'}>
							<div class="photo slide-photo">{(r.slide_image || r.image) && <img src={url((r.slide_image || r.image)!)} alt={r.name} loading="lazy" />}</div>
							<div>
								<div class="mono-label">{r.when}</div>
								<h2>{r.name}</h2>
								<p class="short">{r.short}</p>
								<p class="body">{r.long}</p>
							</div>
						</article>
					))
				}
			</div>
			<button class="icon-btn arrow" data-next aria-label="Next ritual" set:html={arrow('6,3 11,8 6,13')} />
		</div>
	</section>

	<section class="day" aria-labelledby="day-title">
		<div class="day-head">
			<div class="eyebrow">{day.eyebrow}</div>
			<h2 class="h2" id="day-title">{day.title}</h2>
		</div>
		{/* The frame pins to the screen while the visitor scrolls past, and each step of scrolling swaps
		    in the next moment with a short slide-up, like the phone's lock screen. The swap always plays
		    to the end, so it never rests half way between two photos. */}
		<div class="day-track" data-day style={`--count: ${day.moments.length}`}>
			<div class="day-stage">
				<div class="frame photo">
					<ol class="moments">
						{
							day.moments.map((m, i) => (
								<li class="moment" data-state={i === 0 ? 'current' : 'after'}>
									{m.photos?.length ? (
										<div class="collage">
											{m.photos.map((src) => (
												<span>
													<img src={url(src)} alt="" loading="lazy" decoding="async" />
												</span>
											))}
										</div>
									) : (
										m.photo && <img src={url(m.photo)} alt="" loading="lazy" decoding="async" />
									)}
									<p class="clock" aria-hidden="true">
										{splitTime(m.time)[0]}
										{splitTime(m.time)[1] && <span class="ampm">{splitTime(m.time)[1]}</span>}
									</p>
									<div class="caption">
										<span class="range">{m.range}</span>
										<h3>{m.title}</h3>
										{m.text && <p>{m.text}</p>}
									</div>
								</li>
							))
						}
					</ol>
					{/* Where we are in the day. Mouse users can click to jump; everyone else just scrolls. */}
					<div class="dots" aria-hidden="true">
						{day.moments.map((_, j) => <button type="button" tabindex="-1" data-jump={j} class:list={{ on: j === 0 }} />)}
					</div>
				</div>
			</div>
			{/* Invisible: a short stretch of scrolling per moment after the first, while the stage stays pinned. */}
			<div class="day-steps" />
		</div>
	</section>
</Base>

<script>
	const root = document.querySelector<HTMLElement>('[data-slider]');
	if (root) {
		const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
		const tabs = [...root.querySelectorAll<HTMLElement>('[data-go]')];
		const fills = tabs.map((t) => t.querySelector<HTMLElement>('.fill')!);
		const duration = Number(root.dataset.seconds) * 1000;
		let current = 0;
		let elapsed = 0;
		let paused = false;
		let stopped = false; // once the visitor picks a slide, stop auto-advancing

		const render = () => {
			slides.forEach((s, i) => (s.dataset.state = i < current ? 'before' : i === current ? 'current' : 'after'));
			tabs.forEach((t, i) => {
				t.setAttribute('aria-selected', String(i === current));
				fills[i].style.width = `${i < current ? 100 : i === current ? (stopped ? 100 : (elapsed / duration) * 100) : 0}%`;
			});
		};
		const go = (i: number) => {
			current = (i + slides.length) % slides.length;
			elapsed = 0;
			render();
		};

		root.addEventListener('click', (e) => {
			const b = (e.target as Element).closest<HTMLElement>('button');
			if (!b) return;
			stopped = true;
			if (b.dataset.go) go(Number(b.dataset.go));
			else if ('prev' in b.dataset) go(current - 1);
			else if ('next' in b.dataset) go(current + 1);
		});
		// Pause while keyboard users are on the controls. No hover pause: the slider fills the screen, so it looked frozen.
		root.addEventListener('focusin', () => (paused = true));
		root.addEventListener('focusout', () => (paused = false));

		// Auto-advance, unless the visitor asked for less motion.
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
			setInterval(() => {
				if (stopped || paused || document.hidden) return;
				elapsed += 50;
				if (elapsed >= duration) go(current + 1);
				else render();
			}, 50);
		}
	}
	// A day at camp: while the stage is pinned, one swipe (or wheel click) moves exactly one moment. The first
	// bit of scrolling in a direction switches to the next moment, only once per swipe, and when the scroll
	// comes to rest the page eases to that moment's spot. Past the first and last moments it scrolls freely.
	const track = document.querySelector<HTMLElement>('[data-day]');
	if (track) {
		const moments = [...track.querySelectorAll<HTMLElement>('.moment')];
		const dots = [...track.querySelectorAll<HTMLElement>('[data-jump]')];
		const steps = track.querySelector<HTMLElement>('.day-steps')!;
		const last = moments.length - 1;
		const step = () => steps.offsetHeight / Math.max(1, last);
		const progress = () => -track.getBoundingClientRect().top / step(); // 0 = first moment's spot, 1 = second's…
		const clamp = (i: number) => Math.max(0, Math.min(last, i));
		const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
		let current = 0;
		const show = (i: number) => {
			if (i === current) return;
			current = i;
			moments.forEach((m, j) => (m.dataset.state = j < i ? 'before' : j === i ? 'current' : 'after'));
			dots.forEach((d, j) => d.classList.toggle('on', j === i));
		};

		// Where the page last came to rest. A swipe is measured from there: a wheel click can jump the
		// whole way before the first scroll event arrives.
		let anchor = progress();
		let from: number | null = null; // progress when this swipe began
		let fromMoment = 0;
		let settling = false; // our own easing scroll is running
		let touching = false;
		let rest = 0;
		const goTo = (i: number) => {
			settling = true;
			anchor = i;
			scrollTo({ top: track.getBoundingClientRect().top + scrollY + i * step(), behavior: smooth() });
		};
		// Our easing scroll has stopped. Something may have overridden it (Firefox keeps a trackpad swipe
		// coasting, or the scroll bar was dragged), so make the moment match where the page actually rests.
		const settled = () => {
			settling = false;
			const p = progress();
			anchor = p;
			show(clamp(Math.round(p)));
			if (p > -0.01 && p < last + 0.01 && Math.abs(p - current) > 0.02) goTo(current);
		};
		const settle = () => {
			if (touching) return void (rest = window.setTimeout(settle, 150));
			const p = progress();
			const moved = current !== fromMoment;
			from = null;
			anchor = p;
			// Above the first moment or below the last, the page scrolls freely: never pull the visitor back
			// (they scrolled up to the heading, jumped to the top, or a reload restored the scroll). Have the
			// nearest moment ready for when they return.
			if (p < -0.01 || p > last + 0.01) return show(clamp(Math.round(p)));
			// Ease to the current moment if this swipe changed it, or if it came to rest between two moments.
			if (moved || (p > 0.01 && p < last - 0.01)) {
				if (Math.abs(p - current) > 0.01) goTo(current);
			}
		};
		const onScroll = () => {
			clearTimeout(rest);
			rest = window.setTimeout(settle, 150);
			const p = progress();
			if (settling) return;
			if (from === null) (from = anchor), (fromMoment = current);
			const pinned = from > -0.05 && from < last + 0.05;
			// Arriving from above or below, or already scrolled past either end: follow the scroll.
			if (!pinned || p < -0.01 || p > last + 0.01) show(clamp(Math.round(p)));
			else if (current === fromMoment) {
				if (p > from + 0.12) show(clamp(current + 1));
				else if (p < from - 0.12) show(clamp(current - 1));
			}
		};
		let queued = false;
		addEventListener('scroll', () => {
			if (settling) {
				// Our easing scroll: done once it stops moving.
				clearTimeout(rest);
				rest = window.setTimeout(settled, 120);
				return;
			}
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => ((queued = false), onScroll()));
		}, { passive: true });
		// A new swipe counts even while the last one is still coasting: a finger going down, or a wheel/trackpad
		// burst that suddenly picks up speed (coasting only ever slows down).
		const newSwipe = () => {
			settling = false;
			anchor = progress();
			from = null;
		};
		addEventListener('touchstart', () => ((touching = true), newSwipe()), { passive: true });
		// Wheel: a burst's speed rises to a peak and then coasts down. Once it has slowed to under half its peak,
		// a clear pick-up in speed is a new swipe. Only while coasting: at rest, the browser may already have
		// scrolled by the time this runs, and the rest position is the right starting point anyway.
		let peak = 0;
		let low = 0;
		let lastWheelAt = 0;
		addEventListener('wheel', (e) => {
			const d = Math.abs(e.deltaY);
			const now = performance.now();
			const fresh = now - lastWheelAt > 250;
			lastWheelAt = now;
			if (from !== null && !settling && (fresh || (low < peak / 2 && d > Math.max(8, low * 2.5)))) newSwipe();
			if (fresh || from === null || d > peak) (peak = d), (low = d);
			else low = Math.min(low, d);
		}, { passive: true });
		addEventListener('touchend', () => (touching = false), { passive: true });
		addEventListener('touchcancel', () => (touching = false), { passive: true });
		// The photos wait off-screen, below the frame's edge, until they slide in. Safari only loads a lazy
		// image once it's visible, so it would pop in mid-slide: load them all as the section comes near.
		new IntersectionObserver((entries, io) => {
			if (!entries[0].isIntersecting) return;
			track.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
			io.disconnect();
		}, { rootMargin: '100% 0px' }).observe(track);
		track.dataset.ready = ''; // shows the spacer, so there's room to scroll through every moment
		show(clamp(Math.round(progress())));

		// Upright screens center the slide in a full-screen stage, which leaves empty space above it until it
		// pins. Pull the track up under the heading by that much, so the first time sits just below it.
		// Measured from the layout itself (offsetTop ignores scrolling, pinning and the slide transforms), so it
		// holds wherever the page is scrolled, and redone whenever the slide's size changes (fonts, rotation).
		const stage = track.querySelector<HTMLElement>('.day-stage')!;
		const clock = moments[0].querySelector<HTMLElement>('.clock')!;
		const tuck = () => {
			if (!matchMedia('(orientation: portrait)').matches) return track.style.removeProperty('--lead');
			let top = 0;
			for (let el: HTMLElement | null = clock; el && el !== stage; el = el.offsetParent as HTMLElement | null) top += el.offsetTop;
			// Track starts 48px up under the heading block; the time should sit 16px below that block.
			track.style.setProperty('--lead', `${Math.max(0, top - 48 - 16)}px`);
		};
		const ro = new ResizeObserver(tuck);
		[stage, clock, moments[0].querySelector('.caption')!].forEach((el) => ro.observe(el));

		track.addEventListener('click', (e) => {
			const b = (e.target as Element).closest<HTMLElement>('[data-jump]');
			if (!b) return;
			show(Number(b.dataset.jump));
			goTo(Number(b.dataset.jump));
		});
	}
</script>

<style>
	.slider { padding: 0 var(--gutter) 40px; }
	.slider-nav { display: flex; align-items: center; gap: 16px; }
	/* Arrows sit either side of the slide, vertically centered; on phones they drop below it as a pair. */
	.stage { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(16px, 3vw, 40px); }
	.arrow { width: 48px; height: 48px; }
	.arrow:active { transform: scale(0.94); }
	.slide-tabs {
		flex: 1;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(var(--count), minmax(0, 1fr));
		gap: 12px;
	}
	.slide-tab {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 4px 0;
		background: none;
		border: none;
		text-align: left;
		cursor: pointer;
	}
	.bar { display: block; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
	.fill { display: block; height: 100%; width: 0; background: var(--amber); }
	.tab-label { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
	.tab-name { font-size: 15px; font-weight: 600; color: var(--muted); transition: color 0.2s ease; }
	.slide-tab[aria-selected='true'] .tab-name { color: var(--ink); }
	/* Too narrow for three names side by side; the slide itself shows the name. */
	@media (max-width: 560px) {
		.tab-name { display: none; }
		.stage { grid-template-columns: 1fr 1fr; row-gap: 0; }
		.slides { grid-row: 1; grid-column: 1 / -1; }
		[data-prev] { justify-self: end; }
		[data-next] { justify-self: start; }
	}

	.slides { display: grid; overflow-x: clip; }
	.slide {
		grid-area: 1 / 1;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: clamp(32px, 5vw, 72px);
		align-items: center;
		padding: clamp(40px, 5vw, 56px) 0;
		transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0.5s;
	}
	.slide[data-state='before'] { opacity: 0; visibility: hidden; transform: translateX(-24px); }
	.slide[data-state='after'] { opacity: 0; visibility: hidden; transform: translateX(24px); }
	.slide-photo { aspect-ratio: 5 / 4; border-radius: 24px; }
	.slide .mono-label { margin-bottom: 14px; }
	.slide h2 { font-size: clamp(38px, 4.4vw, 52px); line-height: 1.02; margin-bottom: 20px; color: var(--amber); }
	.short { margin: 0 0 16px; color: var(--ink); font-size: 19px; line-height: 1.6; text-wrap: pretty; }
	@media (max-width: 560px) {
		/* Label, progress, slide and arrows fit one phone screen, and scrolling nearby snaps to it.
		   65px is the phone header's height. */
		:global(html) { scroll-snap-type: y proximity; }
		.slider { scroll-snap-align: start; scroll-margin-top: 65px; padding-block: 14px 0; }
		.slider .eyebrow { margin-bottom: 12px; }
		.slide-tab { gap: 6px; }
		.slide { gap: 12px; padding: 14px 0 12px; }
		.slide-photo { aspect-ratio: 5 / 2; border-radius: 18px; }
		.slide .mono-label { margin-bottom: 6px; }
		.slide h2 { font-size: 28px; margin-bottom: 8px; }
		.short { font-size: 15px; line-height: 1.5; margin-bottom: 6px; }
		.slide .body { font-size: 14px; line-height: 1.55; }
		.arrow { width: 44px; height: 44px; }
	}
	/* --pin-top keeps the frame clear of the sticky site header once pinned. --gap is the space above the first
	   photo (under the heading) and below the last (at the page's end). The 3:2 frame fills the screen between them. */
	.day {
		--pin-top: 92px;
		--gap: calc(var(--pin-top) - 40px);
		--frame-h: calc(100svh - var(--pin-top) - var(--gap));
		/* Scrolling per moment: about one swipe. */
		--step: 35svh;
	}
	.day-head { padding: clamp(72px, 9vw, 100px) var(--gutter) 8px; }
	.day-head .h2 { max-width: 720px; text-wrap: balance; }
	/* The stage's top padding is only there to clear the site header once pinned, so the track tucks up under
	   the heading (8px heading padding + --pin-top - 48px = --gap), and the page's 72px bottom space shrinks to --gap. */
	.day-track { margin-top: -48px; margin-bottom: calc(var(--gap) - 72px); }
	/* Without JS there's no spacer, and the section is just the first moment. */
	.day-steps { display: none; }
	.day-track[data-ready] .day-steps { display: block; height: calc((var(--count) - 1) * var(--step)); }
	.day-stage { position: sticky; top: 0; padding: var(--pin-top) var(--gutter) 0; display: grid; justify-items: center; }
	.frame { position: relative; width: min(100%, var(--frame-h) * 1.5); aspect-ratio: 3 / 2; border-radius: 24px; container-type: inline-size; }
	.moments { list-style: none; margin: 0; padding: 0; }
	.moment {
		position: absolute;
		inset: 0;
		transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.45s ease;
	}
	/* The next moment slides up over the current one; going back, it slides down off it. */
	.moment[data-state='after'] { transform: translateY(100%); }
	.moment[data-state='before'] { transform: translateY(-12%); opacity: 0; }
	@media (prefers-reduced-motion: reduce) {
		.moment { transition: none; }
	}
	.moment > img { position: absolute; inset: 0; }
	/* A moment with several photos shows them as a 3-across grid. Each photo fills its cell absolutely:
	   Safari sizes an <img> grid item by the photo instead of the cell. */
	.collage { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 3px; background: var(--bg); }
	.collage > span { position: relative; overflow: hidden; }
	.collage img { position: absolute; inset: 0; }
	/* Soft shade down the left side, where all the text sits, so it reads on bright playa sky. */
	.moment::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to right, rgba(0, 0, 0, 0.5), transparent 60%),
			linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent 35%);
		pointer-events: none;
	}
	/* Time and caption share the left side; the dots have the right to themselves.
	   Sizes follow the frame's width (cqi), so a phone's small frame gets small text. */
	.clock, .caption, .dots { position: absolute; z-index: 1; color: #fff; }
	.clock, .caption { left: clamp(14px, 4cqi, 44px); }
	.clock {
		top: clamp(10px, 3cqi, 36px);
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(40px, 15cqi, 180px);
		line-height: 1;
		letter-spacing: -0.01em;
		text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
	}
	.ampm { margin-left: 0.12em; font-size: 0.3em; letter-spacing: 0.02em; }
	.caption { right: clamp(32px, 7cqi, 88px); bottom: clamp(12px, 3.5cqi, 40px); max-width: 560px; }
	.range { font-family: var(--mono); font-size: clamp(10px, 1.3cqi, 13px); letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber-hi); }
	.caption h3 { margin-top: clamp(4px, 0.8cqi, 8px); font-size: clamp(22px, 5cqi, 48px); line-height: 1.05; }
	.caption p { margin: clamp(4px, 1cqi, 10px) 0 0; font-size: clamp(13px, 1.7cqi, 17px); line-height: 1.5; color: var(--ink); text-wrap: pretty; }
	/* Vertical page dots, like the lock screen's. The current one stretches into a pill. */
	.dots { top: 50%; right: clamp(10px, 2cqi, 24px); transform: translateY(-50%); display: flex; flex-direction: column; gap: clamp(5px, 0.8cqi, 8px); }
	.dots button {
		width: 7px;
		height: 7px;
		padding: 0;
		border: 0;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.45);
		box-shadow: 0 0 6px rgba(0, 0, 0, 0.5);
		cursor: pointer;
		transition: height 0.3s ease, background-color 0.3s ease;
	}
	.dots .on { height: 22px; background: #fff; }
	/* Upright screens: the whole screen is the slide, like a phone's lock screen. The time sits above the
	   3:2 photo and the caption below it (a pinned landscape photo alone would leave most of the screen
	   empty), and they swap together. */
	@media (orientation: portrait) {
		.day-track { margin-top: calc(-48px - var(--lead, 0px)); margin-bottom: -72px; }
		.day-stage { height: 100svh; padding-bottom: 28px; }
		.frame { width: 100%; height: 100%; aspect-ratio: auto; border: 0; border-radius: 0; background: none; }
		.moment {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: clamp(12px, 4cqi, 24px);
		}
		.moment::after { content: none; }
		.moment > img,
		.collage {
			position: relative;
			inset: auto;
			width: 100%;
			height: auto;
			aspect-ratio: 3 / 2;
			border-radius: 16px;
			border: 1px solid var(--amber-line);
		}
		.collage { overflow: hidden; }
		.clock, .caption { position: static; order: -1; text-shadow: none; }
		.caption { order: 1; max-width: none; }
