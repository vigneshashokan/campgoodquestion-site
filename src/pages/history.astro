---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BrcMap from '../components/BrcMap.astro';
import { placeYears } from '../lib/brc';
import { url } from '../lib/url';

const { header, years } = (await getEntry('history', 'history'))!.data;

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
const tilts = ['-1.5deg', '2.5deg', '-3deg', '2deg'];
// Newest first, alternating sides.
const rows = placeYears(years)
	.map((y, i) => ({ ...y, chapter: `CHAPTER ${roman[i] ?? i + 1}` }))
	.reverse()
	.map((y, i) => ({ ...y, flipSide: i % 2 === 1, tilt: tilts[i % tilts.length] }));
---

<Base title="History" description={header.intro}>
	<PageHeader eyebrow={header.eyebrow} title={header.title} glow="50% 0%" center>
		<p class="lede">{header.intro}</p>
	</PageHeader>

	<section class="timeline">
		<div class="spine" aria-hidden="true"></div>
		{
			rows.map((y) => (
				<div class:list={['year', { flip: y.flipSide }]} style={`--accent: ${y.accent}; --tilt: ${y.tilt}`}>
					<div class="dot" aria-hidden="true" />
					<div class="card-col">
						<button type="button" class="card" aria-pressed="false" aria-label={`${y.year}: flip between photo and map`}>
							<span class="card-inner">
								<span class="face">
									<span class="square">
										{y.photo && <img src={url(y.photo)} alt={`Camp Good Question in ${y.year}`} loading="lazy" />}
										{!y.placed && (
											<span class="future">
												<img src={url('/qmark.png')} alt="" />
											</span>
										)}
									</span>
									<span class="caption">
										<span class="caption-big">{y.year}</span>
										<span class="caption-addr">{y.addr}</span>
									</span>
								</span>
								<span class="face back">
									<span class="square map-bg">
										<BrcMap
											variant="square"
											pins={y.pos ? [{ ...y.pos, color: y.accent, label: y.mapLabel }] : []}
											emptyLabel={y.pos ? undefined : y.mapLabel}
										/>
									</span>
									<span class="caption">
										<span class="caption-big">On the playa</span>
										<span class="caption-addr">{y.addr}</span>
									</span>
								</span>
							</span>
						</button>
						<span class="hint" aria-hidden="true">
							<span class="to-map">↻ tap to find us on the playa</span>
							<span class="to-photo">↻ tap to see the photo</span>
						</span>
					</div>
					<div class="text-col">
						<div class="mono-label chapter">{y.chapter}</div>
						<h2>{y.title}</h2>
						<p class="body">{y.note}</p>
					</div>
				</div>
			))
		}
	</section>
</Base>

<script>
	document.querySelectorAll('.card').forEach((card) =>
		card.addEventListener('click', () =>
			card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true')),
		),
	);
</script>

<style>
	.timeline {
		position: relative;
		max-width: 1080px;
		margin: 0 auto;
		padding: 24px var(--edge) 40px;
		display: flex;
		flex-direction: column;
		gap: clamp(56px, 8vw, 96px);
	}
	.spine {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 1px;
		background: linear-gradient(180deg, transparent, rgba(232, 137, 43, 0.5) 8%, rgba(78, 156, 150, 0.5) 80%, transparent);
	}
	.year {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: clamp(40px, 8vw, 120px);
	}
	.year.flip { flex-direction: row-reverse; }
	.dot {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 14px;
		height: 14px;
		margin: -7px 0 0 -7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 6px var(--bg), 0 0 18px var(--accent);
	}

	.card-col {
		flex: 0 1 340px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
	}
	.card {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		perspective: 1400px;
		transform: rotate(var(--tilt));
		transition: transform 0.3s ease;
	}
	/* The tilt straightens on hover; touch screens can't hover, so their cards start straight. */
	@media (hover: hover) {
		.card:hover { transform: rotate(0deg) scale(1.03); }
	}
	@media (hover: none) {
		.card { transform: none; }
	}
	.card-inner {
		display: block;
		position: relative;
		transform-style: preserve-3d;
		transition: transform 0.8s cubic-bezier(0.3, 0.7, 0.2, 1);
	}
	.card[aria-pressed='true'] .card-inner { transform: rotateY(180deg); }
	.face {
		display: block;
		background: var(--ink);
		padding: 14px 14px 0;
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.back { position: absolute; inset: 0; transform: rotateY(180deg); }
	.square { display: block; position: relative; aspect-ratio: 1; background: var(--bg-2); overflow: hidden; }
	.square > img { width: 100%; height: 100%; object-fit: cover; }
	.map-bg { background: radial-gradient(circle at 50% 55%, var(--bg-3), var(--bg) 75%); }
	.future {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(circle at 50% 50%, rgba(232, 137, 43, 0.35), var(--bg-2) 70%);
	}
	.future img { height: 70%; width: auto; filter: drop-shadow(0 0 24px rgba(232, 137, 43, 0.6)); }
	.caption {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 16px 4px 20px;
		color: #3a1410;
	}
	.caption-big { font-family: var(--serif); font-size: 30px; }
	.caption-addr { font-family: var(--mono); font-size: 13px; color: #a8321e; }
	.hint { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; color: var(--muted); }
	.to-photo, .card[aria-pressed='true'] + .hint .to-map { display: none; }
	.card[aria-pressed='true'] + .hint .to-photo { display: inline; }

	.text-col { flex: 0 1 340px; }
	.year.flip .text-col { text-align: right; }
	.chapter { color: var(--accent); margin-bottom: 14px; }
	.text-col h2 { font-size: clamp(34px, 4vw, 48px); line-height: 1.02; margin-bottom: 16px; color: var(--amber); }

	/* Stacked on phones: drop the center spine, keep text left-aligned, and put each chapter's text above its photo. */
	@media (max-width: 720px) {
		.year { gap: 24px; }
		.text-col { order: -1; }
		.spine, .dot { display: none; }
		.year.flip { flex-direction: row; }
		.year.flip .text-col { text-align: left; }
	}
</style>
