---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const contact = (await getEntry('contact', 'contact'))!.data;
const settings = (await getEntry('settings', 'settings'))!.data;

// Netlify sets NETLIFY=true during its builds. Anywhere else (e.g. the GitHub Pages preview)
// there's no form backend, so the form hands off to the visitor's email app instead.
const onNetlify = !!process.env.NETLIFY;
const formAttrs = onNetlify
	? { method: 'POST', action: url('/thanks/'), 'data-netlify': 'true', 'netlify-honeypot': 'bot-field', 'data-mode': 'netlify' }
	: { method: 'POST', action: `mailto:${settings.contact_email}`, enctype: 'text/plain', 'data-mode': 'email' };
---

<Base title="Contact" description={contact.subtitle}>
	<section class="contact">
		<div class="inner">
			<div class="eyebrow">{contact.eyebrow}</div>
			<h1 class="display">{contact.title}</h1>
			<h2 class="subtitle">{contact.subtitle}</h2>

			<!-- On Netlify: Netlify Forms, detected at deploy time; submissions land in the Netlify dashboard. -->
			<form name="contact" {...formAttrs} data-email={settings.contact_email}>
				{
					onNetlify && (
						<>
							<input type="hidden" name="form-name" value="contact" />
							<p hidden>
								<label>
									Don't fill this out: <input name="bot-field" />
								</label>
							</p>
						</>
					)
				}
				<div class="row">
					<label class="field">
						<span class="mono-label">Your name</span>
						<input type="text" name="name" autocomplete="name" placeholder="Dusty" />
					</label>
					<label class="field">
						<span class="mono-label">Email</span>
						<input type="email" name="email" autocomplete="email" placeholder="dusty@deepplaya.com" required />
					</label>
				</div>
				<fieldset class="field">
					<legend class="mono-label">What's it about?</legend>
					<div class="topics">
						{
							contact.topics.map((t) => (
								<label class="topic">
									<input type="radio" name="topic" value={t} class="visually-hidden" />
									<span>{t}</span>
								</label>
							))
						}
					</div>
				</fieldset>
				<label class="field">
					<span class="mono-label">Your question</span>
					<textarea name="message" rows="5" placeholder="Ask away…" required></textarea>
				</label>
				<p class="notice" role="alert" hidden></p>
				<div class="submit-row">
					<button type="submit" class="btn">Send it into the dust</button>
					<span class="reply-note">{contact.reply_note}</span>
				</div>
			</form>

			<div class="sent" hidden>
				<span class="sent-label">RECEIVED</span>
				<h3>Good question, <span data-sent-name></span>.</h3>
				<p>We'll write back to <span data-sent-email></span> soon.</p>
				<button type="button" class="again">Ask another</button>
			</div>
		</div>
	</section>
</Base>

<script>
	const form = document.querySelector<HTMLFormElement>('form[name="contact"]')!;
	const error = form.querySelector<HTMLElement>('.notice')!;
	const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
	const sent = document.querySelector<HTMLElement>('.sent')!;
	const email = form.elements.namedItem('email') as HTMLInputElement;
	const message = form.elements.namedItem('message') as HTMLTextAreaElement;

	form.noValidate = true; // we show our own messages instead of the browser's

	// Links can pre-fill the form, e.g. /contact/?topic=Notify%20Me&message=... from the Join Us page.
	const params = new URLSearchParams(location.search);
	form.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) => (r.checked = r.value === params.get('topic')));
	if (params.get('message')) message.value = params.get('message')!;

	const fail = (text: string, field?: HTMLElement) => {
		error.textContent = text;
		error.hidden = false;
		field?.setAttribute('aria-invalid', 'true');
		field?.focus();
	};

	form.addEventListener('input', () => {
		error.hidden = true;
		form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
	});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) return fail('Add an email so we can write back.', email);
		if (!message.value.trim()) return fail("Tell us what's on your mind.", message);

		const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
		if (form.dataset.mode === 'email') {
			const topic = form.querySelector<HTMLInputElement>('input[name="topic"]:checked')?.value;
			const subject = `Good question${topic ? ` · ${topic}` : ''}${name ? ` from ${name}` : ''}`;
			const body = `${message.value.trim()}\n\n${name || 'Sent from the website'} (${email.value.trim()})`;
			location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			form.querySelector('.reply-note')!.textContent = `Your email app should open with your message. If it doesn't, email us at ${form.dataset.email}.`;
			return;
		}

		button.disabled = true;
		try {
			const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
			const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
			if (!res.ok) throw new Error(String(res.status));
		} catch {
			return fail(`Something went wrong sending that. Try again, or email us at ${form.dataset.email}.`);
		} finally {
			button.disabled = false;
		}

		sent.querySelector('[data-sent-name]')!.textContent = name.split(' ')[0] || 'friend';
		sent.querySelector('[data-sent-email]')!.textContent = email.value.trim();
		form.hidden = true;
		sent.hidden = false;
	});

	// Keep name and email for the next question.
	sent.querySelector('.again')!.addEventListener('click', () => {
		message.value = '';
		form.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) => (r.checked = false));
		sent.hidden = true;
		form.hidden = false;
		message.focus();
	});
</script>

<style>
	.contact {
		position: relative;
		overflow: hidden;
		padding: clamp(64px, 9vw, 110px) var(--gutter) 80px;
		min-height: 520px;
		background: radial-gradient(circle at 50% 30%, rgba(232, 137, 43, 0.4), rgba(210, 86, 30, 0.15) 30%, transparent 58%);
	}
	.inner { max-width: 960px; margin: 0 auto; text-align: center; }
	/* Fill each line before wrapping (not balanced), so "Got a question?" stays whole on line one;
	   on phones the size tracks the screen width so it fits, with room to spare for Safari's wider text. */
	.display { text-wrap: wrap; font-size: min(11.5vw, 48px); }
	@media (min-width: 560px) { .display { font-size: clamp(48px, 6.5vw, 84px); } }
	.subtitle { font-size: clamp(24px, 2.8vw, 34px); line-height: 1.1; margin-bottom: 40px; color: var(--ink-2); }

	form, .sent { max-width: 560px; margin: 0 auto; text-align: left; }
	form { display: flex; flex-direction: column; gap: 22px; }
	.row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 22px; }
	.field { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; border: none; min-width: 0; }
	.field .mono-label { text-transform: uppercase; padding: 0; }
	input, textarea {
		width: 100%;
		background: rgba(27, 21, 18, 0.6);
		border: 1px solid rgba(244, 230, 207, 0.2);
		border-radius: 14px;
		padding: 14px 16px;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 17px;
		outline: none;
		transition: border-color 0.2s ease;
	}
	textarea { resize: vertical; line-height: 1.55; }
	input:focus, textarea:focus { border-color: var(--amber); }
	[aria-invalid='true'] { border-color: var(--rust); }

	legend.mono-label { margin-bottom: 10px; }
	.topics { display: flex; flex-wrap: wrap; gap: 8px; }
	.topic span {
		display: block;
		cursor: pointer;
		padding: 10px 16px;
		border-radius: 999px;
		font-size: 15px;
		font-weight: 600;
		border: 1px solid var(--amber-line);
		color: var(--ink-2);
		transition: background 0.2s ease, color 0.2s ease;
	}
	.topic input:checked + span { background: var(--amber); border-color: var(--amber); color: var(--bg); }
	.topic input:focus-visible + span { outline: 2px solid var(--amber); outline-offset: 3px; }

	.submit-row { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
	.submit-row .btn { padding: 18px 32px; font-size: 17px; }
	.submit-row .btn:disabled { opacity: 0.6; cursor: wait; }
	.reply-note { color: var(--muted); font-size: 14px; }

	.sent {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 520px;
		padding: 32px;
		border-radius: 24px;
		background: var(--amber);
		color: var(--bg);
	}
	.sent-label { font-family: var(--mono); font-size: 13px; letter-spacing: 0.2em; }
	.sent h3 { font-size: 36px; line-height: 1.1; }
	.sent p { margin: 0; font-size: 18px; line-height: 1.6; }
	.again {
		align-self: flex-start;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
