---
import { CENTER, ESPLANADE, OUTER, STREETS, polar, streetRadius } from '../lib/brc';

interface Pin {
	x: number;
	y: number;
	color: string;
	label: string;
	labelAt?: 'below' | 'left' | 'right' | '' | null;
}
interface Props {
	pins: Pin[];
	/** Streets to draw in a year's color, e.g. { E: '#4e9c96' } */
	rings?: Record<string, string>;
	/** "wide" crops to the city arc (home page); "square" fits a photo card. */
	variant?: 'wide' | 'square';
	/** Text shown where the camp would be when there's no address yet. */
	emptyLabel?: string;
}
const { pins, rings = {}, variant = 'wide', emptyLabel } = Astro.props;

const big = variant === 'square';
const fontSize = big ? 13 : 11;
const [halo, dot] = big ? [14, 6] : [12, 5];
const cream = '#f4e6cf';

// The city is an arc from 2:00 to 10:00, drawn the long way round through 6:00.
const arc = (r: number) => {
	const a = polar(2, r), b = polar(10, r);
	return `M${a.x} ${a.y} A${r} ${r} 0 1 1 ${b.x} ${b.y}`;
};
const hours = Array.from({ length: 17 }, (_, i) => 2 + i / 2);
const labelPos = (p: Pin) =>
	p.labelAt === 'left' ? { x: p.x - 16, y: p.y + 4, anchor: 'end' }
	: p.labelAt === 'right' ? { x: p.x + 17, y: p.y + 4, anchor: 'start' }
	: { x: p.x, y: p.y + (big ? 30 : 27), anchor: 'middle' };
---

<svg viewBox={big ? '-34 20 468 468' : '-36 82 472 348'} class:list={['map', variant]} fill="none" role="img" aria-label="Map of Black Rock City">
	{
		hours.map((h) => {
			const whole = Number.isInteger(h);
			const a = polar(h, ESPLANADE), b = polar(h, OUTER);
			const t = polar(h, 218);
			return (
				<>
					<line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke={cream} stroke-opacity={whole ? 0.22 : 0.1} stroke-dasharray={whole ? undefined : '2 3'} />
					{whole && <text x={t.x} y={t.y + 3} fill={cream} fill-opacity=".45" font-family="JetBrains Mono" font-size="8" text-anchor="middle">{h}:00</text>}
				</>
			);
		})
	}
	<path d={arc(ESPLANADE)} stroke={cream} stroke-opacity=".35" stroke-width="1.5" />
	{
		[...STREETS].map((s, i) => (
			<path d={arc(streetRadius(s))} stroke={rings[s] ?? cream} stroke-opacity={rings[s] ? 0.7 : i < 6 ? 0.18 : 0.12} />
		))
	}
	<circle cx={CENTER} cy={CENTER} r="12" stroke={cream} stroke-opacity=".35" />
	<g stroke={cream} stroke-opacity=".22">
		<line x1="212" y1="200" x2="270" y2="200" /><line x1="188" y1="200" x2="130" y2="200" />
		<line x1="200" y1="212" x2="200" y2="270" /><line x1="200" y1="188" x2="200" y2="123" />
	</g>
	<g transform="translate(100 100) scale(.5)" stroke={cream} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
		<path d="M200 188 L203 191.5 L200 195 L197 191.5 Z" fill={cream} />
		<path d="M200 195 L200 204" /><path d="M192 186 L200 198 L208 186" /><path d="M195 213 L200 204 L205 213" />
	</g>
	<circle cx="200" cy="120" r="3" fill={cream} fill-opacity=".5" />
	{
		pins.map((p) => {
			const l = labelPos(p);
			return (
				<>
					<circle cx={p.x} cy={p.y} r={halo} fill={p.color} fill-opacity=".28" />
					<circle cx={p.x} cy={p.y} r={dot} fill={p.color} />
					<text x={l.x} y={l.y} text-anchor={l.anchor} fill={p.color} font-family="JetBrains Mono" font-size={fontSize}>{p.label}</text>
				</>
			);
		})
	}
	{emptyLabel && <text x="200" y="305" text-anchor="middle" fill="#8f7d66" font-family="JetBrains Mono" font-size={fontSize}>{emptyLabel}</text>}
</svg>

<style>
	.map { display: block; width: 100%; }
	.wide { max-width: 920px; margin: 0 auto; }
	.square { height: 100%; }
</style>
